# Copy to `.env` and edit. WS_URL + DATABASE_URL are required (here or subdex.toml).

WS_URL=wss://rpc.polkadot.io
DATABASE_URL=postgres://postgres:postgres@localhost:55432/subdex

# --- Optional (override subdex.toml) ---
# START_HEIGHT=
# BATCH_SIZE=100
# CONCURRENCY=16
# SS58_PREFIX=42
# STRICT=0
# SERVE=1               # serve the GraphQL API alongside indexing
# FOLLOW=1              # follow the tip after backfill (0 = exit)
# GRAPHQL_PORT=4350
# RUST_LOG=info
